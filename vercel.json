{
  "version": 2,
  "name": "crisislink",
  "outputDirectory": "dashboard",
  "functions": {
    "api/classify.py": { "runtime": "python3.9", "maxDuration": 30 },
    "api/health.py":   { "runtime": "python3.9", "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/health",   "dest": "/api/health.py"   },
    { "src": "/api/classify", "dest": "/api/classify.py" },
    { "src": "/(.*)",         "dest": "/$1"              }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "env": {
    "GEMINI_API_KEY":       "@gemini-api-key",
    "CRISISLINK_API_TOKEN": "@crisislink-api-token"
  }
}
