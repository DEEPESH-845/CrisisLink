# CrisisLink Backend — Required Environment Variables
# Copy to .env and fill in real values. Never commit .env to version control.

GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=./serviceaccount.json
FIREBASE_DATABASE_URL=
CRISISLINK_BACKEND_URL=http://localhost:8001
CRISISLINK_API_TOKEN=crisislink-dev-token
SECRET_KEY=
CRISISLINK_USE_REAL_SERVICES=true
ENVIRONMENT=development
